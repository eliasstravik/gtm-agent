# Required. Created by the Slack connector flow; local development can use slack/my-agent.
SLACK_CONNECTOR=slack/my-agent

# Optional, but both values are required when a persistent GTM workspace is enabled.
# GITHUB_CONNECTOR=github/my-agent
# GTM_WORKSPACE_REPOSITORY=owner/gtm-workspace

# Optional, and only with a connected workspace. Both values are required to host
# gtm-workflow runs against the workspace's own Turso database; a Vercel Marketplace
# Turso install sets both. The token is brokered at the sandbox firewall and never
# enters the sandbox environment.
# TURSO_DATABASE_URL=libsql://<database>-<org>.turso.io
# TURSO_AUTH_TOKEN=

# Optional. A separate, budgeted Vercel AI Gateway key for workflow model calls,
# brokered at the sandbox firewall. Never reuse the deployment's own AI_GATEWAY_API_KEY.
# GTM_WORKFLOW_GATEWAY_API_KEY=

# Optional. Comma-separated exact hostnames that accepted workflow adapters may call.
# GTM_WORKFLOW_PROVIDER_HOSTS=api.example-data.com,enrich.example.net

# Optional trusted production control. Set all six only after the connected
# workspace's non-Git-connected Vercel workflow project already exists. These
# values stay in the Eve host runtime and never enter the sandbox.
# GTM_WORKFLOW_VERCEL_TEAM_ID=team_xxx
# GTM_WORKFLOW_VERCEL_PROJECT_ID=prj_xxx
# GTM_WORKFLOW_VERCEL_PROJECT=org-workflows
# GTM_WORKFLOW_VERCEL_URL=https://org-workflows.vercel.app
# GTM_WORKFLOW_VERCEL_TOKEN=
# GTM_WORKFLOW_RUN_SECRET=
