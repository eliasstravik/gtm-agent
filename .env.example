# Required. Created by the Slack connector flow; local development can use slack/my-agent.
SLACK_CONNECTOR=slack/my-agent

# Optional, but both values are required when a persistent GTM workspace is enabled.
# GITHUB_CONNECTOR=github/my-agent
# GTM_WORKSPACE_REPOSITORY=owner/gtm-workspace

# Optional for ordinary workspace writes; required for Git-deployed workflows.
# Use the verified Git author identity connected to the Vercel project owner.
# GTM_WORKSPACE_COMMIT_AUTHOR_NAME=GitHub Username
# GTM_WORKSPACE_COMMIT_AUTHOR_EMAIL=123456+username@users.noreply.github.com

# Optional, and only with a connected workspace. All three values are required to
# author gtm-workflow projects against the workspace's own Turso database. A Vercel
# Marketplace Turso install sets the first two; create the read-only token with
# `turso db tokens create <database> --read-only`. The read-only token is brokered
# at the sandbox firewall for every session; the write token is brokered only while
# an approved save applies migrations. Neither enters the sandbox environment.
# TURSO_DATABASE_URL=libsql://<database>-<org>.turso.io
# TURSO_AUTH_TOKEN=
# TURSO_READ_ONLY_AUTH_TOKEN=

# Optional. Comma-separated exact hostnames that accepted workflow adapters may call
# from the sandbox without credentials, for example a keyless fixture endpoint. Paid
# provider calls happen on Vercel with the workflow project's own variables.
# GTM_WORKFLOW_PROVIDER_HOSTS=api.example-data.com,enrich.example.net

# Optional trusted production run control. Set both after the connected
# workspace's Git-connected Vercel workflow project exists. These values stay
# in the Eve host runtime and never enter the sandbox.
# GTM_WORKFLOW_VERCEL_URL=https://org-workflows.vercel.app
# GTM_WORKFLOW_RUN_SECRET=
