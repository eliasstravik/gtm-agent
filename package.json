{
  "name": "gtm-agent",
  "version": "1.0.3",
  "private": false,
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "fetch-skills": "node scripts/fetch-skills.mjs",
    "build": "pnpm fetch-skills && eve build",
    "dev": "eve dev",
    "start": "eve start",
    "typecheck": "tsc --noEmit",
    "eval": "eve eval",
    "check": "pnpm fetch-skills && pnpm typecheck && pnpm test && eve build",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@vercel/connect": "2.0.0",
    "eve": "0.52.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.14.0",
  "gtm": {
    "skillsRelease": "v1.0.4"
  }
}
